{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "node",
    "module": "commonjs",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "removeComments": true,
    "allowUnreachableCode": true,
    "noFallthroughCasesInSwitch": false,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "outDir": "./dist/",
    "incremental": true,
    "typeRoots": [
      "node_modules/@types",
      "@types",
      "node_modules/@rockstat/rock-me-ts/src/types",
      "node_modules/@rockstat/rock-me-ts/@types"
    ],
    "baseUrl": "./",
    "paths": {
      "@app/*": [ "./src/*" ]
    }
  },
  "compileOnSave": true
}