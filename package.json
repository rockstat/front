{
  "name": "@rockstat/front",
  "version": "4.3.1",
  "description": "Rockstat Front service",
  "scripts": {
    "start": "ts-node ./src/start.ts",
    "start:prod": "node -r 'source-map-support/register' dist/start",
    "start:dev": "LOG_LEVEL=debug  TS_NODE_BASEURL=./src ts-node-dev  --watch ../web-sdk ./src/start.ts | pino-pretty -L debug",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "tslint -c tslint.json -t stylish -p ./tsconfig.json",
    "security-check": "nsp check",
    "watch": "tsc -w",
    "tun": "lt --port 10001 -s rstdev",
    "build:push": "git add dist/* && git add package.json && git commit -m build && git push origin HEAD",
    "build:patch": "yarn run patch && git add package.json",
    "patch": "yarn version --loose-semver --new-version patch"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rockstat/front"
  },
  "_moduleAliases": {
    "@app": "./src"
  },
  "author": "Dmitry Rodin <madiedinro@gmail.com>",
  "homepage": "https://rock.st",
  "devDependencies": {
    "@types/content-type": "^1.1.8",
    "@types/cookie": "^0.5.1",
    "@types/dotenv": "^8.2.0",
    "@types/get-value": "^3.0.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/micro": "^7.3.7",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^18.13.0",
    "@types/pino": "^7.0.5",
    "@types/qs": "^6.9.7",
    "@types/statsd-client": "^0.4.3",
    "@types/ws": "^8.5.4",
    "module-alias": "^2.2.3",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.1.2",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@rockstat/rock-me-ts": "file:../rockmets",
    "@rockstat/web_sdk": "file:../web-sdk",
    "content-type": "^1.0.5",
    "cookie": "^0.5.0",
    "eventemitter3": "^5.0.0",
    "fflate": "^0.8.2",
    "find-my-way": "^7.4.0",
    "get-value": "^3.0.1",
    "jsonwebtoken": "^9.0.2",
    "micro": "^10.0.1",
    "npm": "^10.7.0",
    "qs": "^6.11.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^4.1.2",
    "source-map-support": "^0.5.21",
    "tsc-watch": "^6.0.0",
    "typedi": "^0.10.0",
    "ws": "^8.12.0"
  }
}
